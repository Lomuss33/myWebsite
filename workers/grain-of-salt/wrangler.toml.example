# Example Cloudflare Wrangler configuration for The Grain of Salt intake gateway
# Copy to wrangler.toml when provisioning external Cloudflare Worker + D1 in owner account.
# Do NOT commit live account IDs, database IDs, or secret tokens.

name = "grain-of-salt-gateway"
main = "src/index.js"
compatibility_date = "2026-01-01"

[vars]
ALLOWED_ORIGINS = "https://lovro-music.de,http://localhost:5173,http://127.0.0.1:4173"
DISABLE_SUBMISSIONS = "false"
DISABLE_AI_TRIAGE = "false"
DISABLE_AI_REPAIR = "false"
DISABLE_GITHUB_ISSUES = "true"
DISABLE_GITHUB_PRS = "true"
GITHUB_REPOSITORY = "Lomuss33/myWebsite"
AI_MODEL = "gpt-4o-mini"
MAX_DAILY_AI_TRIAGE_JOBS = "20"
MAX_DAILY_REPAIR_ATTEMPTS = "3"
MAX_DAILY_GLOBAL_REPORTS = "60"

# Durable D1 database binding (REQUIRED in production; Worker fails closed with 503 durable_storage_unconfigured if absent):
[[d1_databases]]
binding = "DB"
database_name = "grain_of_salt_db"
database_id = "<YOUR_D1_DATABASE_ID>"

# Optional Cloudflare Workers AI binding (alternative to AI_API_KEY + AI_API_URL):
# [ai]
# binding = "AI"

# Required secrets (set via `wrangler secret put <NAME>`, never in frontend or git):
# - TURNSTILE_SECRET_KEY (REQUIRED in production; Worker fails closed with 503 turnstile_unconfigured if absent)
# - SOURCE_HASH_SALT
# - AI_API_KEY (optional; when absent and [ai] is unbound, deterministic Stage 2 triage runs without paid AI calls)
# - GITHUB_APP_TOKEN (optional; used to dispatch `.github/workflows/grain-of-salt-triage.yml` when DISABLE_GITHUB_PRS="false")
